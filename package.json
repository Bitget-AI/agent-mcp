{
  "name": "@bitget-ai/bitget-agent-mcp",
  "version": "3.0.2",
  "packageManager": "pnpm@8.14.1",
  "description": "Official Bitget MCP Server for the Unified Trading Account (UTA / v3) API — exposes a curated, progressively-discoverable intent surface (account, trade, market, strategy, …) to any MCP-compatible AI host (Claude Desktop, Cursor, Continue, …) over stdio.",
  "type": "module",
  "license": "MIT",
  "mcpName": "io.github.Bitget-AI/bitget-agent-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bitget-AI/agent-mcp.git"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "bitget-agent-mcp": "./lib/index.js"
  },
  "files": [
    "lib",
    "server.json",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "VERSION"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/run.mjs",
    "e2e:paper": "E2E_SUITE=paper node e2e/run.mjs",
    "e2e:live": "E2E_SUITE=agent-sub node e2e/run.mjs",
    "e2e:main": "E2E_SUITE=main node e2e/run.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "bitget",
    "bitget-api",
    "bitget-mcp",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "trading",
    "crypto",
    "cryptocurrency",
    "exchange",
    "uta",
    "unified-trading-account",
    "spot",
    "futures",
    "margin",
    "ai-agent",
    "claude",
    "claude-desktop",
    "cursor",
    "continue",
    "anthropic"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@bitget-ai/bitget-agent-sdk": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  }
}
